#ifndef ARES_CREDENTIALS_H
#define ARES_CREDENTIALS_H

// OPCIONAL no Router: o Gateway novo se anuncia por beacon e é achado sozinho.
// Preencha com o MAC do ESP2 (Gateway) só se quiser que o Router também teste o
// enlace com ele diretamente. Com FF:FF:FF:FF:FF:FF o teste fica desligado.
#define GATEWAY_MAC {0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF}

#endif
